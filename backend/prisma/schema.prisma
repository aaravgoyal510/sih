datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

model User {
  id            String   @id @default(uuid())
  phone         String   @unique
  passwordHash  String?
  preferredLang String   @default("en") // en | hi | mr
  createdAt     DateTime @default(now())
  party         Party?
}

model Party {
  id       String      @id @default(uuid())
  userId   String      @unique
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  district String
  village  String?
  roles    PartyRole[]
  // BUYER parties are deliberately classified by purchasing pattern, not a new
  // authorization role. Null preserves existing records until reviewed.
  buyerType BuyerType?
  fpoId    String?
  fpo      Fpo?        @relation(fields: [fpoId], references: [id])

  listings             Listing[]
  requirements         Requirement[]
  verifications        Verification[]
  credibility          CredibilityScore?
  warehouseReceipts    WarehouseReceipt[]
  marketplaceAds       MarketplaceAd[]
  farmActivities       FarmActivityLog[]
  cropIssueReports     CropIssueReport[]
  recommendations      Recommendation[]   @relation("FarmerRecommendations")
  buyerRecommendations Recommendation[]   @relation("BuyerRecommendations")
  trustScores          TrustScore[]
  notifications        Notification[]
  decisionQuotes       DecisionQuote[]
  decisionRuns         DecisionRun[]
  trustHistory         TrustHistory[]
}

enum TrustRole {
  BUYER
  FARMER
}

enum TrustTier {
  HIGH_TRUST
  MEDIUM_TRUST
  LOW_TRUST
}

enum RecommendationRisk {
  LOW
  MEDIUM
  HIGH
}

model Recommendation {
  id                 String             @id @default(uuid())
  farmerPartyId      String
  farmer             Party              @relation("FarmerRecommendations", fields: [farmerPartyId], references: [id], onDelete: Restrict)
  buyerPartyId       String?
  buyer              Party?             @relation("BuyerRecommendations", fields: [buyerPartyId], references: [id], onDelete: Restrict)
  listingId          String
  listing            Listing            @relation(fields: [listingId], references: [id], onDelete: Restrict)
  what               Json
  why                Json
  risk               RecommendationRisk
  riskBasis          Json // Nonempty array of evidence-backed explanations
  what_if_wait       Json // AVAILABLE scenario or UNAVAILABLE with reason
  expectedNetPaise   BigInt
  baselineNetPaise   BigInt?
  deltaPaise         BigInt? // expectedNetPaise - baselineNetPaise
  trustSnapshot      Json? // Immutable public-safe score, metrics, asOf/version
  inputSnapshot      Json // Quantity/grade, quotes/costs/source dates and assumptions
  explanationVersion String
  createdAt          DateTime           @default(now())
  validUntil         DateTime
  runId              String?
  run                DecisionRun? @relation(fields: [runId], references: [id], onDelete: Restrict)
  quoteId            String?
  quote              DecisionQuote? @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  scenarioStatus     String? // Legacy records remain null; READY / EXPIRED / INVALIDATED
  formulaVersion     String?
  evidenceHash       String?
  sharedFpoId        String?
  poolPlanId         String?
  poolPlan           PoolPlan? @relation(fields: [poolPlanId], references: [id], onDelete: Restrict)
  selection          DecisionSelection?
  poolConsent        PoolConsent?

  @@index([farmerPartyId, createdAt])
  @@index([listingId, validUntil])
}

model TrustScore {
  id                       String    @id @default(uuid())
  partyId                  String
  party                    Party     @relation(fields: [partyId], references: [id], onDelete: Restrict)
  role                     TrustRole
  score                    Int // 0..100, constrained in reviewed SQL/API validation
  tier                     TrustTier
  kycVerified              Boolean   @default(false)
  totalTransactions        Int       @default(0) // Completed, not listings/offers
  eligibleOrders           Int       @default(0)
  onTimePayments           Int       @default(0)
  eligiblePayments         Int       @default(0)
  onTimePaymentPct         Float? // Null without evidence; BUYER only
  onTimeFulfillmentPct     Float? // FARMER only; policy pending approval
  disputesCount            Int       @default(0) // Filed cases; not guilt
  confirmedAtFaultDisputes Int       @default(0)
  cancelledOrdersCount     Int       @default(0) // Attributable cancellations
  counterpartRating        Float? // 1..5; null with no verified ratings
  ratingCount              Int       @default(0)
  provisional              Boolean   @default(true)
  suspended                Boolean   @default(false)
  formulaVersion           String
  evidenceSnapshot         Json // Public metrics separated from restricted evidence refs
  asOf                     DateTime
  updatedAt                DateTime  @updatedAt

  @@unique([partyId, role])
  @@index([role, tier, suspended])
}

// Durable in-app events. No external SMS/push delivery is implied.
model Notification {
  id        String    @id @default(uuid())
  partyId   String
  party     Party     @relation(fields: [partyId], references: [id], onDelete: Cascade)
  eventKey  String
  kind      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([partyId, eventKey])
  @@index([partyId, readAt, createdAt])
}

model BookingEvent {
  id        String   @id @default(uuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actorId   String
  kind      String
  snapshot  Json
  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
}

enum PartyRole {
  FARMER
  FPO_ADMIN
  BUYER
  STORAGE_OPERATOR
  TRANSPORT_OPERATOR
  EQUIPMENT_PROVIDER
  LABOR_CONTRACTOR
  INPUT_SUPPLIER
  DISTRICT_ADMIN
  STATE_ADMIN
  PLATFORM_ADMIN
}

enum BuyerType {
  LOCAL
  BULK
}

model Fpo {
  id              String  @id @default(uuid())
  name            String
  district        String
  registrationRef String? // NABARD/SFAC registry ref (Tier 3)
  members         Party[]
}

enum ResourceType {
  CROP_LOT
  COLD_STORAGE
  TRANSPORT
  EQUIPMENT_SERVICE
  LABOR
  USED_EQUIPMENT
  INPUT_GROUP_BUY
  CONTRACT_FARMING
}

model Listing {
  id            String        @id @default(uuid())
  partyId       String
  party         Party         @relation(fields: [partyId], references: [id])
  resourceType  ResourceType
  district      String
  availableFrom DateTime?
  availableTo   DateTime?
  price         Float?
  priceUnit     String? // per_kg | per_quintal | per_day | per_trip | flat
  status        ListingStatus @default(OPEN)
  attributes    Json // validated per resourceType at API layer, see TechSpec.md
  createdAt     DateTime      @default(now())

  offers          Offer[]
  recommendations Recommendation[]
  decisionRuns    DecisionRun[]
  decisionQuotes  DecisionQuote[] @relation("QuoteLot")
  serviceQuotes   DecisionQuote[] @relation("QuoteService")
  poolPlan        PoolPlan?

  @@index([partyId, status, createdAt])
}

enum ListingStatus {
  DRAFT
  OPEN
  POOLED
  MATCHED
  BOOKED
  COMPLETED
  EXPIRED
}

model Requirement {
  id             String       @id @default(uuid())
  partyId        String
  party          Party        @relation(fields: [partyId], references: [id])
  resourceType   ResourceType
  district       String?
  quantityNeeded Float?
  budget         Float?
  deadline       DateTime?
  attributes     Json
  createdAt      DateTime     @default(now())

  offers Offer[]

  @@index([partyId, createdAt])
}

model Offer {
  id            String       @id @default(uuid())
  listingId     String
  listing       Listing      @relation(fields: [listingId], references: [id])
  requirementId String?
  requirement   Requirement? @relation(fields: [requirementId], references: [id])
  price         Float
  status        OfferStatus  @default(PENDING)
  createdAt     DateTime     @default(now())
  booking       Booking?
  decisionQuote DecisionQuote?

  @@index([listingId, status])
  @@index([requirementId, status])
}

enum OfferStatus {
  PENDING
  COUNTERED
  ACCEPTED
  REJECTED
}

model Booking {
  id                 String            @id @default(uuid())
  offerId            String            @unique
  offer              Offer             @relation(fields: [offerId], references: [id])
  totalAmount        Float?
  agreementUrl       String?
  fulfillmentStatus  FulfillmentStatus @default(PENDING)
  paymentStatus      PaymentStatus     @default(PENDING)
  logisticsNote      String?
  createdAt          DateTime          @default(now())
  dispute            Dispute?
  ratings            Rating[]
  agreementSnapshot  Json?
  deliveryDueAt      DateTime?
  paymentDueAt       DateTime?
  cancelledAt        DateTime?
  cancelledById      String?
  cancellationReason String?
  events             BookingEvent[]
  decisionSelections DecisionSelection[]
  outcomeEvents      BookingOutcomeEvent[]
  providerReservations DecisionReservation[]
}

model DecisionRun {
  id String @id @default(uuid())
  farmerPartyId String
  farmer Party @relation(fields: [farmerPartyId], references: [id], onDelete: Restrict)
  listingId String
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  requestKey String
  inputHash String
  input Json
  status String
  diagnostics Json
  createdAt DateTime @default(now())
  recommendations Recommendation[]
  @@unique([farmerPartyId, requestKey])
  @@index([farmerPartyId, createdAt])
}

model DecisionQuote {
  id String @id @default(uuid())
  kind String // SALE / TRANSPORT / STORAGE
  issuerPartyId String
  issuer Party @relation(fields: [issuerPartyId], references: [id], onDelete: Restrict)
  listingId String
  listing Listing @relation("QuoteLot", fields: [listingId], references: [id], onDelete: Restrict)
  serviceListingId String?
  serviceListing Listing? @relation("QuoteService", fields: [serviceListingId], references: [id], onDelete: Restrict)
  offerId String? @unique
  offer Offer? @relation(fields: [offerId], references: [id], onDelete: Restrict)
  quantityGrams BigInt
  unitPricePaise BigInt
  priceBasis String // PER_KG / TOTAL / PER_KG_DAY
  route String // BUYER / MARKET / FPO / TRANSPORT / STORAGE
  origin String
  destination String
  startAt DateTime
  endAt DateTime
  paymentDueAt DateTime?
  validUntil DateTime
  status String @default("ACTIVE")
  evidence Json
  createdAt DateTime @default(now())
  recommendations Recommendation[]
  reservations DecisionReservation[]
  @@index([listingId, kind, status, validUntil])
  @@index([issuerPartyId, createdAt])
}

model DecisionSelection {
  id String @id @default(uuid())
  recommendationId String @unique
  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Restrict)
  actorId String
  selectedAt DateTime @default(now())
  evidenceHash String
  bookingId String?
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  linkedAt DateTime?
  @@index([bookingId])
}

model DecisionReservation {
  id String @id @default(uuid())
  quoteId String
  quote DecisionQuote @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  bookingId String
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  releasedAt DateTime?
  @@unique([quoteId, bookingId])
}

model PoolPlan {
  id String @id @default(uuid())
  fpoId String
  administratorId String
  listingId String @unique
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  members Json // Immutable lot/owner/quantity snapshots; no implicit consent
  status String @default("DRAFT")
  createdAt DateTime @default(now())
  executedAt DateTime?
  recommendations Recommendation[]
  consents PoolConsent[]
  @@index([fpoId, status])
}

model PoolConsent {
  id String @id @default(uuid())
  poolPlanId String
  poolPlan PoolPlan @relation(fields: [poolPlanId], references: [id], onDelete: Restrict)
  listingId String
  farmerPartyId String
  recommendationId String @unique
  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@unique([poolPlanId, listingId])
}

model BookingOutcomeEvent {
  id String @id @default(uuid())
  bookingId String
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  kind String
  actorId String
  responsiblePartyId String
  amountPaise BigInt?
  occurredAt DateTime
  dueAt DateTime?
  evidenceRef String?
  simulation Boolean
  evidenceLevel String // SIMULATED / SELF_REPORTED / COUNTERPARTY_ATTESTED
  idempotencyKey String
  relatedEventId String?
  relatedEvent BookingOutcomeEvent? @relation("OutcomeCorrection", fields: [relatedEventId], references: [id], onDelete: Restrict)
  relatedEvents BookingOutcomeEvent[] @relation("OutcomeCorrection")
  payload Json
  createdAt DateTime @default(now())
  @@unique([bookingId, actorId, idempotencyKey])
  @@index([bookingId, occurredAt])
  @@index([responsiblePartyId, kind])
}

model TrustHistory {
  id String @id @default(uuid())
  partyId String
  party Party @relation(fields: [partyId], references: [id], onDelete: Restrict)
  evidenceHash String
  snapshot Json
  legacySnapshot Json
  formulaVersion String
  createdAt DateTime @default(now())
  @@unique([partyId, evidenceHash])
  @@index([partyId, createdAt])
}

model DecisionJob {
  id String @id @default(uuid())
  eventKey String @unique
  kind String
  targetId String
  attempts Int @default(0)
  completedAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  @@index([completedAt, createdAt])
}

enum FulfillmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  ESCROWED
  RELEASED
  FAILED
}

model Rating {
  id              String   @id @default(uuid())
  bookingId       String
  booking         Booking  @relation(fields: [bookingId], references: [id])
  giverPartyId    String
  receiverPartyId String
  score           Int // 1-5
  comment         String?
  createdAt       DateTime @default(now())
}

model Dispute {
  id                String          @id @default(uuid())
  bookingId         String          @unique
  booking           Booking         @relation(fields: [bookingId], references: [id])
  raisedByPartyId   String
  respondentPartyId String
  category          DisputeCategory
  reason            String
  evidenceUrls      String[]
  status            DisputeStatus   @default(OPEN)
  districtAdminId   String?
  stateAdminId      String?
  resolutionNote    String?
  slaDeadline       DateTime?
  resolvedAt        DateTime?
  createdAt         DateTime        @default(now())

  auditLogs DisputeAuditLog[]
}

enum DisputeCategory {
  PAYMENT
  QUALITY
  LOGISTICS
  STORAGE_DAMAGE
  SERVICE_NOT_RENDERED
  OTHER
}

enum DisputeStatus {
  OPEN
  UNDER_DISTRICT_REVIEW
  ESCALATED
  UNDER_STATE_REVIEW
  RESOLVED
  REJECTED
}

model DisputeAuditLog {
  id         String   @id @default(uuid())
  disputeId  String
  dispute    Dispute  @relation(fields: [disputeId], references: [id])
  actorId    String
  fromStatus String
  toStatus   String
  note       String?
  createdAt  DateTime @default(now())
}

model CredibilityScore {
  id           String   @id @default(uuid())
  partyId      String   @unique
  party        Party    @relation(fields: [partyId], references: [id])
  score        Float    @default(50) // 0-100
  txnCount     Int      @default(0)
  onTimePayPct Float?
  disputeCount Int      @default(0)
  suspended    Boolean  @default(false)
  updatedAt    DateTime @updatedAt
}

model Verification {
  id              String             @id @default(uuid())
  partyId         String
  party           Party              @relation(fields: [partyId], references: [id])
  role            PartyRole
  documentType    String
  documentRef     String?
  documentUrl     String?
  status          VerificationStatus @default(PENDING)
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  expiresAt       DateTime?
  slaDeadline     DateTime?
  createdAt       DateTime           @default(now())

  auditLogs VerificationAuditLog[]

  @@index([partyId, status])
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  ESCALATED
}

model VerificationAuditLog {
  id             String       @id @default(uuid())
  verificationId String
  verification   Verification @relation(fields: [verificationId], references: [id])
  actorId        String
  fromStatus     String
  toStatus       String
  note           String?
  createdAt      DateTime     @default(now())
}

model MandiPrice {
  id         String   @id @default(uuid())
  crop       String
  district   String
  market     String
  pricePerKg Float
  arrivalsKg Float?
  source     String // AGMARKNET | ENAM
  recordedAt DateTime
  ingestedAt DateTime @default(now())

  @@index([crop, district, recordedAt])
}

model PortalSyncLog {
  id       String   @id @default(uuid())
  portal   String // AGMARKNET | ENAM | WDRA | IMD | NABARD_SFAC | PAYMENT_GW
  tier     Int // 1 = live, 2 = simulated-live, 3 = stubbed
  status   String // SUCCESS | FAILED | STUBBED
  message  String?
  syncedAt DateTime @default(now())
}

model WarehouseReceipt {
  id           String   @id @default(uuid())
  partyId      String
  party        Party    @relation(fields: [partyId], references: [id])
  warehouseRef String
  crop         String
  quantityKg   Float
  issuedAt     DateTime
  status       String // ACTIVE | REDEEMED
}

model DistrictDailyStats {
  id                          String   @id @default(uuid())
  district                    String
  date                        DateTime
  avgPricePerCrop             Json // { "onion": 1850, "tomato": 900 }
  totalLotsCreated            Int
  totalLotsMatched            Int
  totalLotsPooled             Int
  activeStorageUtilizationPct Float?
  activeTransportBookings     Int
  pendingVerifications        Int
  openDisputes                Int
  resolvedDisputesWithinSla   Int

  @@index([district, date])
}

model StateDailyStats {
  id                        String   @id @default(uuid())
  date                      DateTime
  avgPricePerCropByDistrict Json // { district: { crop: avgPrice } }
  aggregationRateByDistrict Json
  integrationHealthSummary  Json
  escalatedItemsCount       Int

  @@index([date])
}

model OtpCode {
  id        String   @id @default(uuid())
  phone     String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model MarketplaceAd {
  id          String   @id @default(uuid())
  partyId     String
  party       Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  title       String
  description String
  imageUrl    String?
  targetUrl   String?
  placement   String // RESOURCE_DETAIL | BUYER_DASHBOARD | PROVIDER_DASHBOARD
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([placement, active])
}

model FarmActivityLog {
  id           String   @id @default(uuid())
  partyId      String
  party        Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  crop         String
  activityType String // SOWING | IRRIGATION | FERTILIZATION | PESTICIDE_SPRAY | HARVESTING | OTHER
  costAmount   Float // ₹ cost incurred
  notes        String?
  date         DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([partyId, crop])
}

model CropIssueReport {
  id              String   @id @default(uuid())
  partyId         String
  party           Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  crop            String
  imageUrl        String?
  issueType       String // PEST_ATTACK | LEAF_BLIGHT | NUTRIENT_DEFICIENCY | WILTING | OTHER
  aiDiagnosis     String // Rule-based or AI Diagnostic result
  advisoryNote    String // Recommended treatment / action
  expertEscalated Boolean  @default(false) // Fallback routing to KVK expert
  status          String   @default("DIAGNOSED") // DIAGNOSED | ESCALATED_TO_KVK | RESOLVED
  createdAt       DateTime @default(now())

  @@index([partyId, status])
}
